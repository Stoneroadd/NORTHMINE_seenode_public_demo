# Perfil local explÃ­cito. Un proceso sin ENVIRONMENT se trata como producciÃ³n
# y se negarÃ¡ a iniciar hasta recibir su configuraciÃ³n segura.
ENVIRONMENT=development
NORTHMINE_MODE=demo
NORTHMINE_API_PREFIX=/api
NORTHMINE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
NORTHMINE_DEMO_SEED=20260529

# ── SEGURIDAD ────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR-POR-CLAVE-ALEATORIA-DE-64-CHARS
REFRESH_SECRET_KEY=CAMBIAR-POR-OTRA-CLAVE-ALEATORIA-DE-64-CHARS
PASSWORD_SALT=CAMBIAR-POR-SALT-UNICO-DE-TU-INSTALACION

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
NORTHMINE_DEMO_MODE=true
NORTHMINE_SQL_SERVER=
NORTHMINE_SQL_DB=WENCO
NORTHMINE_SQL_USER=
NORTHMINE_SQL_PASSWORD=

# ── IA ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NORTHMINE_OPENAI_API_KEY=
NORTHMINE_AI_PROVIDER=auto
NORTHMINE_AI_MODEL=gpt-5.6-terra
NORTHMINE_AI_REASONING_EFFORT=low
NORTHMINE_SPEECH_TRANSCRIPTION_ENABLED=true
NORTHMINE_SPEECH_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Respaldo sin nube para instalaciones Windows (requiere audio WAV PCM).
NORTHMINE_WINDOWS_SPEECH_ENABLED=true
NORTHMINE_WINDOWS_SPEECH_LANGUAGE=es-ES
NORTHMINE_WINDOWS_SPEECH_TIMEOUT_SECONDS=20
# Motor offline recomendado. Instalar con backend/scripts/install_vosk_model.ps1.
NORTHMINE_VOSK_SPEECH_ENABLED=true
NORTHMINE_VOSK_MODEL_PATH=

# ── SEGURIDAD AVANZADA ───────────────────────────────────────────────────────
PASSWORD_HISTORY_COUNT=5
SESSION_TIMEOUT_MINUTES=30
BCRYPT_ROUNDS=12

# ── SEGURIDAD AVANZADA (Sprint 10) ────────────────────────────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIT_ENCRYPTION_KEY=
SLACK_WEBHOOK_URL=

# ── ENTORNO ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
NORTHMINE_ALLOW_DEMO_LOGIN=true
NORTHMINE_VERSION=2.0.0
NORTHMINE_LOG_DIR=../logs
NORTHMINE_AUDIT_DB=../northmine_audit.db
NORTHMINE_USERS_DB=../northmine_users.db
NORTHMINE_BOOTSTRAP_ADMIN_USER=
NORTHMINE_BOOTSTRAP_ADMIN_PASSWORD=
NORTHMINE_BOOTSTRAP_ADMIN_ROLE=ADMIN
NORTHMINE_BOOTSTRAP_ADMIN_EMAIL=
NORTHMINE_BOOTSTRAP_ADMIN_FULL_NAME=
NORTHMINE_ALLOW_LOCAL_BOOTSTRAP_ADMIN=false
LOG_LEVEL=INFO
