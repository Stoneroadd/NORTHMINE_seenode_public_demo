ENVIRONMENT=demo
NORTHMINE_MODE=demo
NORTHMINE_DEMO_MODE=true
NORTHMINE_ALLOW_DEMO_LOGIN=true
NORTHMINE_API_PREFIX=/api
NORTHMINE_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
NORTHMINE_VERSION=2.0.0
NORTHMINE_LOG_DIR=../logs
NORTHMINE_AUDIT_DB=../northmine_audit.db
NORTHMINE_USERS_DB=../northmine_users.db
NORTHMINE_BOOTSTRAP_ADMIN_USER=
NORTHMINE_BOOTSTRAP_ADMIN_PASSWORD=
NORTHMINE_BOOTSTRAP_ADMIN_ROLE=ADMIN
NORTHMINE_BOOTSTRAP_ADMIN_EMAIL=
NORTHMINE_BOOTSTRAP_ADMIN_FULL_NAME=
NORTHMINE_ALLOW_LOCAL_BOOTSTRAP_ADMIN=false
LOG_LEVEL=INFO

# Optional LIVE voice path. The key stays server-side; deterministic demo
# does not need it and never counts as physical voice acceptance.
OPENAI_REALTIME_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
