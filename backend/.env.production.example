ENVIRONMENT=production
NORTHMINE_MODE=sql
NORTHMINE_DEMO_MODE=false
NORTHMINE_ALLOW_DEMO_LOGIN=false
# Los sync locales estan apagados en produccion. EjecÃºtalos con un worker o
# scheduler dedicado; no los habilites en replicas de la API.
NORTHMINE_LOCAL_AUTO_SYNC_ENABLED=false
NORTHMINE_API_PREFIX=/api
NORTHMINE_CORS_ORIGINS=https://northmine.example.com
NORTHMINE_VERSION=2.0.0
NORTHMINE_LOG_DIR=../logs
NORTHMINE_AUDIT_DB=../northmine_audit.db
NORTHMINE_USERS_DB=../northmine_users.db
NORTHMINE_BOOTSTRAP_ADMIN_USER=admin_empresa
NORTHMINE_BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE_UNICO
NORTHMINE_BOOTSTRAP_ADMIN_ROLE=ADMIN
NORTHMINE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NORTHMINE_BOOTSTRAP_ADMIN_FULL_NAME=Administrador NORTHMINE
NORTHMINE_ALLOW_LOCAL_BOOTSTRAP_ADMIN=false
SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_64_CHARS
REFRESH_SECRET_KEY=REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO_64_CHARS
PASSWORD_SALT=REEMPLAZAR_CON_SALT_UNICO
AUDIT_ENCRYPTION_KEY=
LOG_LEVEL=INFO
# TLS obligatorio para WENCO: instalar la CA corporativa en el host/contenedor
# en vez de desactivar la validacion de certificado.
NORTHMINE_SQL_DRIVER=ODBC Driver 18 for SQL Server
NORTHMINE_SQL_TRUST_SERVER_CERTIFICATE=false
# Redis compartido con TLS y ACL; obligatorio para limites y locks distribuidos.
NORTHMINE_REDIS_URL=rediss://default:REEMPLAZAR_PASSWORD@redis.internal:6380/0
