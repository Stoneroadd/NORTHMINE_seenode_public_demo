ENVIRONMENT=demo
NORTHMINE_MODE=demo
NORTHMINE_DATA_MODE=DEMO
NORTHMINE_DEMO_MODE=true
NORTHMINE_ALLOW_DEMO_LOGIN=true
NORTHMINE_LOCAL_AUTO_SYNC_ENABLED=false
NORTHMINE_CORS_ORIGINS=https://TU-FRONTEND.seenode.app
SECRET_KEY=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS
REFRESH_SECRET_KEY=REEMPLAZAR_CON_OTROS_64_CARACTERES_ALEATORIOS
PASSWORD_SALT=REEMPLAZAR_CON_OTROS_64_CARACTERES_ALEATORIOS
AUDIT_ENCRYPTION_KEY=REEMPLAZAR_CON_FERNET_KEY_44_CARACTERES
NORTHMINE_AUDIT_DB=/tmp/northmine_demo_audit.db
NORTHMINE_USERS_DB=/tmp/northmine_demo_users.db
# Almacen durable de solicitudes de demo (obligatorio en seenode).
# 1) Crear una base PostgreSQL gestionada en seenode (Databases -> Create).
# 2) Pegar aqui el connection string que entrega seenode.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_PUERTO/NOMBRE_DB
# 3) Clave estable (minimo 32 caracteres) para el deduplicado de solicitudes.
#    Generar con: python -c "import secrets; print(secrets.token_hex(32))"
NORTHMINE_DEMO_ACCESS_FINGERPRINT_KEY=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS
NORTHMINE_SHIFT_TARGET_TONS=167400
NORTHMINE_MONTHLY_TARGET_TONS=9610000

# ── VOZ AGENTE (Etapa 4 - ElevenLabs) ─────────────────────────────────────────
# Opcional: sin esto, el agente cae automaticamente a voz del navegador o solo
# texto (fallback ya implementado). Si se agrega, usar una key con limite de
# uso propio - este es un demo publico.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=L4N9j1wT9BMWxuC0QVid
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=20
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.82
ELEVENLABS_SPEED=0.96

# ── OPENAI REALTIME LIVE ──────────────────────────────────────────────────────
